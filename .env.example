# ── Application ───────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=debug

# ── Ports ─────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus

# ── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=nexus
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Riot API ──────────────────────────────────────────────────
RIOT_API_KEY=RGAPI-your-api-key-here
RIOT_API_RATE_LIMIT_PER_SECOND=20
RIOT_API_RATE_LIMIT_PER_2MIN=100
RIOT_DEFAULT_REGION=na1

# ── JWT / Auth ────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# ── Grafana (prod only) ──────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Caddy (prod only) ────────────────────────────────────────
DOMAIN=localhost

# ── ClickHouse Cloud (optional) ──────────────────────────────
# Set to true when connecting to ClickHouse Cloud (HTTPS on port 8443)
# CLICKHOUSE_SECURE=true
# CLICKHOUSE_PORT=8443
