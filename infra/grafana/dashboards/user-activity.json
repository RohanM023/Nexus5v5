{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "title": "Active Users",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(user_sessions_active{service=\"nexus-api\"})"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "title": "Draft Sessions / min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(draft_sessions_created_total{service=\"nexus-api\"}[5m]) * 60",
          "legendFormat": "sessions/min"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "title": "Registrations / min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(user_registrations_total{service=\"nexus-api\"}[5m]) * 60",
          "legendFormat": "registrations/min"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "title": "Match Ingestion Volume",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(matches_inserted_total{service=\"nexus-api\"}[5m]) * 60",
          "legendFormat": "inserted/min ({{region}})"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "title": "Top Endpoints",
      "type": "table",
      "targets": [
        {
          "expr": "topk(10, sum by (endpoint) (rate(http_requests_total{service=\"nexus-api\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "title": "Sessions by Mode",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (mode) (draft_sessions_active{service=\"nexus-api\"})",
          "legendFormat": "{{mode}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["nexus", "users"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Nexus User Activity",
  "uid": "nexus-user-activity"
}
