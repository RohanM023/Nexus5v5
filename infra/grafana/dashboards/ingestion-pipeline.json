      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ingestion_job_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ingestion_job_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(ingestion_job_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
