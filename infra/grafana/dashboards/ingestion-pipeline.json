  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "matches/s",
            "lineWidth": 2,
            "drawStyle": "line",
            "fillOpacity": 15,
            "pointSize": 5
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "title": "Ingestion Throughput (matches fetched vs inserted)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(matches_fetched_total[5m])) by (region)",
          "legendFormat": "fetched ({{region}})"
        },
        {
          "expr": "sum(rate(matches_inserted_total[5m])) by (region)",
          "legendFormat": "inserted ({{region}})"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "errors/s",
            "lineWidth": 2,
            "drawStyle": "line",
            "fillOpacity": 15,
            "pointSize": 5
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "title": "Ingestion Errors by Stage",
      "type": "timeseries",
      "targets": [
