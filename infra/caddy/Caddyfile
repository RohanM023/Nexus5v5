{$DOMAIN:localhost} {
    # API reverse proxy
    handle /api/* {
        reverse_proxy api:8000
    }

    # WebSocket support for draft
    handle /api/v1/draft/live/* {
        reverse_proxy api:8000
    }

    # Frontend reverse proxy
    handle {
        reverse_proxy web:3000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org data:; connect-src 'self' wss:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
}
